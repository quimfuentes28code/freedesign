// Configuración de Cloudflare Workers. La app se sirve como sitio estático desde ./dist.
// Los secretos NO van aquí: en local usad .dev.vars y en producción `wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freedesign",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
