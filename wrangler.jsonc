// Configuración de Cloudflare Workers.
// - La web (React) se sirve como sitio estático desde ./dist.
// - Las rutas /api/* las atiende el Worker (worker/index.ts), que guarda los datos en la base de datos D1.
// Los secretos NO van aquí: en local usad .dev.vars y en producción `wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freedesign",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freedesign",
      // En local no hace falta un id real. Para publicar: `npx wrangler d1 create freedesign`
      // y poner aquí el id que devuelve (ver README).
      "database_id": "ef3df381-0ad6-435c-be8c-b87c19c913ea",
      "migrations_dir": "migrations"
    }
  ],
  // Archivos (fotos de materiales y, más adelante, bocetos, estampados…). Para publicar:
  // `npx wrangler kv namespace create freedesign-files` y poner aquí el id que devuelve.
  "kv_namespaces": [
    {
      "binding": "FILES",
      "id": "f48e0a146bb4423c98d121f15dd24eee"
    }
  ]
}
