{
  "name": "freedesign",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "wrangler d1 migrations apply DB --local",
    "dev": "vite",
    "build": "tsc && tsc -p worker && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "model": "node scripts/convert-model.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.2"
  },
  "allowScripts": {
    "workerd@1.20261101.1": true,
    "workerd@1.20261102.1": true,
    "esbuild@0.28.2": true
  }
}
